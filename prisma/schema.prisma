// ============================================================
// Prisma Schema — Focus Point
// نظام إدارة مساحة دراسة (طاولات دراسة + مراسم فنية)
//
// ملاحظة إصدار Prisma 7:
// - provider = "prisma-client" (العميل الجديد الخالي من Rust)
// - output = "./generated/prisma" (مطلوب — يُولَّد العميل خارج node_modules)
// - إعدادات الاتصال (url) لا توضع هنا بل في prisma.config.ts
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// الطلاب
// ============================================================
model Student {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  phone     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sessions  Session[]

  @@map("students")

  // ملاحظة: في PostgreSQL، gen_random_uuid() و now() هما الدوال
  // الافتراضية على مستوى قاعدة البيانات — أي حماية/تحقق إضافي
  // يتم يدوياً داخل route handlers (لا يوجد RLS/أمان على مستوى DB).
}

// ============================================================
// الأماكن (كراسي داخل قاعات)
// كل صف = كرسي فعلي واحد:
//   - room: القاعة ('social' | 'silent' | 'smoking') — CHECK عبر SQL
//   - group_label: اسم الطاولة/البار الذي يتبع له الكرسي
//   - seat_number: رقم الكرسي داخل مجموعته
//   - seat_group: مجموعة التخصيص الدقيقة (المنطق الذي يعتمد عليه
//     تخصيص الكرسي) — CHECK عبر SQL:
//       'social_table'  → كل كراسي Social
//       'silent_writing'→ طاولتا الكتابة الكبيرتان في Silent
//       'silent_bar'    → البار الدراسي في Silent
//       'smoking_bar'   → كل كراسي Smoking
// ============================================================
model Spot {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room        String // 'social' | 'silent' | 'smoking' — تتحقق منها CHECK على مستوى DB
  groupLabel  String    @map("group_label")
  seatNumber  Int       @map("seat_number")
  seatGroup   String    @map("seat_group") // مجموعة التخصيص (تتحقق منها CHECK على مستوى DB)
  isOccupied  Boolean   @default(false) @map("is_occupied")
  sessions    Session[]

  @@map("spots")
}

// ============================================================
// الجلسات (ربط الطالب بالمكان)
// ============================================================
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  spotId    String   @map("spot_id") @db.Uuid
  checkIn   DateTime @default(now()) @map("check_in") @db.Timestamptz(6)
  checkOut  DateTime? @map("check_out") @db.Timestamptz(6)
  status    String   @default("active") // 'active' | 'ended' — يُتحقق منها دائماً في الكود
  // حقول الفوترة — تُحفظ لحظة إنهاء الجلسة داخل نفس الـ transaction
  // (لا تُمتلأ عند الجلسات النشطة ولا للجلسات المنتهية قبل هذا التحديث).
  billableHours      Int?     @map("billable_hours") // الساعات المحتسبة للأجر (حد أدنى ساعة)
  sessionAmount      Decimal? @map("session_amount") @db.Decimal(12, 2) // المبلغ قبل الخصم = ساعات × سعر
  hourlyRateSnapshot Decimal? @map("hourly_rate_snapshot") @db.Decimal(12, 2) // سعر الساعة لحظة الإنهاء

  // حقول الخصم الاختياري — تُملأ لحظة إنهاء الجلسة داخل نفس الـ transaction
  // (null = بلا خصم؛ والجلسات المنتهية قبل الميزة تبقى null).
  // sessionAmount يبقى "المبلغ قبل الخصم" (رسوم الساعات قبل الخصم)، و
  // final_amount = (رسوم الساعات + مجموع الخدمات) − discount_amount.
  discountScope  String?  @map("discount_scope") // 'total' | 'hours' | 'orders' — CHECK في DB
  discountType   String?  @map("discount_type") // 'percent' | 'fixed' | 'free_hours' — CHECK في DB
  discountValue  Decimal? @map("discount_value") @db.Decimal(12, 2) // القيمة المُدخلة (نسبة/مبلغ/ساعات)
  discountAmount Decimal? @map("discount_amount") @db.Decimal(12, 2) // القيمة الفعلية المخصومة بالليرة
  discountNote   String?  @map("discount_note") // سبب الخصم (اختياري)
  finalAmount    Decimal? @map("final_amount") @db.Decimal(12, 2) // المبلغ النهائي بعد الخصم

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  spot    Spot    @relation(fields: [spotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orders  Order[]

  @@map("sessions")
}

// ============================================================
// الخدمات المتاحة للمساحة
// ============================================================
model Service {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  category String? // تصنيف اختياري (طباعة/مشروبات/...)
  price    Decimal @default(0) @db.Decimal // يستخدم لاحقاً لحساب الأرباح
  orders   Order[]
  hospitalityLogs HospitalityLog[]

  @@map("services")
}

// ============================================================
// الضيافة — أسماء محفوظة (للضيوف أو الإدارة) لتُعاد استخدامها
// لا يدخل أي شيء من هذا الجدول بالإيرادات أبداً (مقياس إحصائي فقط).
// ============================================================
model HospitalityRecipient {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  type      String   @default("guest") // 'guest' | 'management' — CHECK في DB
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  logs      HospitalityLog[]

  @@map("hospitality_recipients")
}

// ============================================================
// سجل الضيافة — كل تسجيل (صنف + كمية) مقدَّم مجاناً لضيف أو للإدارة.
// unit_price_snapshot = سعر وقت التسجيل للمرجع فقط (لا يُحتسب إيراداً).
// ============================================================
model HospitalityLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  recipientType  String  @default("guest") @map("recipient_type") // 'guest' | 'management' — CHECK في DB
  recipientId    String? @map("recipient_id") @db.Uuid // اختياري — الاسم المحفوظ
  guestLabel     String? @map("guest_label") // نص حر للاسم/الجهة (للضيوف العابرين)
  quantity       Int     @default(1)
  guestsCount    Int     @default(1) @map("guests_count") // عدد الأشخاص بهذا التسجيل
  note           String?
  unitPriceSnapshot Decimal @default(0) @map("unit_price_snapshot") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  service   Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recipient HospitalityRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("hospitality_logs")
}

// ============================================================
// الطلبات (خدمة مطلوبة خلال جلسة)
// ============================================================
model Order {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  status    String   @default("pending") // 'pending' | 'done' | 'cancelled' — يُتحقق منها في الكود + CHECK في DB
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("orders")
}

// ============================================================
// الإعدادات العامة (قيمة سلسلة لكل مفتاح)
//   hourly_rate_syp → سعر الساعة الواحدة بالليرة السورية (عدد صحيح)
// ============================================================
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}