# ============================================================
# Focus Point - الاتصال بقاعدة PostgreSQL المحلية
# (PostgreSQL مثبت محلياً مباشرة — دون Supabase أو Docker أو سحابة)
# ============================================================
# انسخ هذا الملف إلى .env.local وعدّل القيم حسب اتصالك المحلي.
#
# Prisma 7 يقرأ .env.local عبر dotenv (راجع prisma.config.ts)،
# وNext.js يقرأه أيضاً — مصدر واحد للاتصال.

DATABASE_URL=postgresql://user:password@localhost:5432/focus_point

# كلمة مرور لوحة التحكم (/admin)
# تنبيه: حل مؤقت (password ثابت) — يجب استبداله بنظام مصادقة حقيقي لاحقاً.
ADMIN_PASSWORD=change-me

# مجلد رفع ملفات الطباعة — ضعه خارج مجلد المشروع (مثال لمسار محلي).
# إن تُرك فارغاً يُستخدم ./uploads داخل المشروع (مضاف لـ .gitignore).
UPLOAD_DIR=C:/Users/YourUser/AppData/Local/StudyZone/uploads

# رابط باركود الاستقبال لصفحة /admin/qr-code.
# غيّره لعنوان IP الجهاز على شبكة المكان ثم أعد تشغيل السيرفر.
NEXT_PUBLIC_CHECKIN_URL=http://localhost:3000/checkin